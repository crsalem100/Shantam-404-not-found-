# ─────────────────────────────────────────────────────────────
# FixFirst environment variables
# Copy to .env.local for local dev. All AI keys are OPTIONAL —
# the app runs fully on mock logic when they are absent.
# ─────────────────────────────────────────────────────────────

# Google Gemini — multimodal photo + transcript analysis & scoring
# Used in: src/lib/ai.ts (analyzeReport)
GEMINI_API_KEY=

# ElevenLabs — voice confirmations, facilities briefings, accessibility alerts
# Used in: src/lib/voice.ts (falls back to browser SpeechSynthesis)
ELEVENLABS_API_KEY=

# Snowflake — durable storage for reports, scores, clusters, analytics
# Used in: src/lib/store.ts (currently localStorage)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=

# Backboard — long-term memory of routes, accessibility needs, history
# Used in: src/lib/memory.ts
BACKBOARD_API_KEY=

# Map provider (optional) — leave blank to use built-in map placeholder
NEXT_PUBLIC_MAPBOX_TOKEN=

# App
PORT=3000
